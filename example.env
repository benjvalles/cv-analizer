# Configuración del modelo LLM (compatible con OpenAI)
# Copia este archivo como .env y rellena los valores

# API Key del servicio LLM (requerido)
OPENAI_API_KEY=tu-api-key-aqui

# URL base del endpoint del LLM (opcional, valor por defecto: https://api.openai.com/v1)
# LLM_BASE_URL=https://api.openai.com/v1

# Nombre del modelo a usar (opcional, valor por defecto: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini